# HamStudy 环境配置模板
# cp .env.example .env → 只需替换 PB_ADMIN_PWD → chmod 600 .env
# .env 含口令，已被 git 忽略。优先级：shell 环境变量 > .env > 内置默认值。
# 端口 / 域名 / 监听地址只在这里改；nginx 与 systemd 由 tools/config.py render 派生。
# 前端不读本文件，固定用 location.origin + /pb。

# 公网默认：80 / 0.0.0.0 / 通配 Host；有域名时改 SERVER_NAME。
# 本机多站点测试改回 SITE_PORT=8091、LISTEN_ADDR=127.0.0.1，
# 并用 NGINX_CONF 显式指向各自的站点配置。
PB_PORT=8199
SITE_PORT=80
LISTEN_ADDR=0.0.0.0
SERVER_NAME=_

# 全新部署先执行 superuser create <邮箱> <密码>；邮箱域名必须带点。
# 替换二进制时要与 PB_VERSION 同版本、同平台。
PB_VERSION=0.40.6
PB_ADMIN=admin@example.com
PB_ADMIN_PWD=REPLACE_WITH_A_RANDOM_STRONG_PASSWORD
PB_MIN_PWD=8

# 可选覆盖：需要时另起一行
# SERVICE_USER=www-data   systemd 运行用户，需可写 public/data、dist/data、pb/pb_data、logs
# NGINX_CONF=/etc/nginx/conf.d/<项目目录名>.conf   nginx 非标准路径时必填
# NGINX_SYNC=0            certbot 接管 443 后关闭端口自动同步
